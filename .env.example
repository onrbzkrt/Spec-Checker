# Microsoft Entra ID app registration (spec-checker)
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=paste-the-secret-VALUE-here

# SharePoint site
SITE_HOST=yourtenant.sharepoint.com
SITE_PATH=/sites/InteriorEngineering

# Claude API (extraction)
ANTHROPIC_API_KEY=paste-your-key-here
# ANTHROPIC_MODEL=claude-haiku-5-5
# Only for keys not scoped to a workspace (wrkspc_...):
# ANTHROPIC_WORKSPACE_ID=

# Shared secret Power Automate sends in the X-API-Key header
SPEC_CHECKER_API_KEY=generate-a-long-random-value

# Optional overrides
# SPECS_LIBRARY=Part Specs
# STANDARDS_LIBRARY=Standards
# REGISTER_LIST=Part Register
